NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Mínimo 32 caracteres. Assina os QR Codes dos checkpoints e o cookie de sessão.
# Obrigatório em produção; em dev usa um segredo fixo de desenvolvimento.
QR_SIGNING_SECRET=
# Senha do painel do shopping (/admin). Padrão em dev: growlithe
ADMIN_PASSCODE=
# URL pública que vai dentro dos QR Codes impressos (ex.: https://growlithe.vercel.app).
# Na Vercel, se vazio, usa o domínio de produção do projeto.
NEXT_PUBLIC_APP_URL=
# "true" recusa scans fora do horário do shopping (10h–22h, horário de Palmas)
ENFORCE_MALL_HOURS=false
# Web Push dos avisos de Missão Relâmpago. Gere com: npx web-push generate-vapid-keys
# Sem as três, o card "Ativar avisos" não aparece e o painel não envia push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@growlithe.app
# Opcional: liga a consulta do cupom fiscal na SEFAZ (docs/09-integracao-sefaz.md)
INFOSIMPLES_TOKEN=
INFOSIMPLES_NFCE_URL=
